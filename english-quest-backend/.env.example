# --- Environment ---
# "development" (default) or "production". In production, JWT_SECRET and
# TEACHER_PASSWORD must be changed and strong, otherwise the app refuses to start.
APP_ENV=development

# --- Database (local PostgreSQL) ---
# Adjust user/password/host/port to your local Postgres. Do NOT commit real credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_quest

# --- JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Seed ---
# Set SEED_DEMO=false in production to skip the demo teacher account and content.
SEED_DEMO=true
TEACHER_EMAIL=teacher@englishquest.dev
TEACHER_PASSWORD=Teacher123
TEACHER_FIRST_NAME=Teacher
TEACHER_LAST_NAME=Quest
