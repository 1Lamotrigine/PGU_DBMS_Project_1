NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Google OAuth 2.0 Web client ID (same value as the backend GOOGLE_CLIENT_ID).
# Leave empty to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must match the backend JWT_SECRET so middleware.ts can verify token signatures.
# Leave empty to skip signature verification (dev only, UX guard).
JWT_SECRET=change-me-in-production-super-secret-key
